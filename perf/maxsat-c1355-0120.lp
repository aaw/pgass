% difficulty: medium
% expect: SAT
% cost: 33
%
% ASP Competition 2015, MaxSAT, instance c1355_F120gat-414gat@1, with the
% domain's encoding ahead of the instance facts.
%
% Grounding is what this case measures, not search. Two parts of the encoding
% are quadratic in the instance when the join gets them wrong: the
% "#count{ X : pred(C,X) }" is a join of its own run once per clause, and
% "pred(C,Y) :- inClause(C,X), nVar(Y), Y = -X." pairs every clause literal
% with every negative variable unless Y is bound before the nVar step. Either
% one going wrong puts grounding alone into the tens of seconds.
% Took 2.64s when it was added.

pVar(X) | nVar(X) :- vars(X).

auxClause(C) :- #count{ X : pred(C,X) } >= 1, clause(C).
:- not auxClause(C), clause(C).

auxClause(C) :- #count{ X : pred(C,X); C : blockingLiteral(C) } >= 1, weightedClause(C,_).
:- not auxClause(C), weightedClause(C,_).

{blockingLiteral(C) : weightedClause(C,W)}.
:~ blockingLiteral(C), weightedClause(C,W). [W@1,C]

pred(C,X) :- inClause(C,X), pVar(X).
pred(C,Y) :- inClause(C,X), nVar(Y), Y=-X.

% #show pVar/1.

vars(1..2192).
weightedClause(1,1).
inClause(1,-1).
weightedClause(2,1).
inClause(2,-2).
